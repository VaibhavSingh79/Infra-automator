# .env.example — copy to .env and fill in from your own `terraform output`
# (see Runbook.md, section 2 and 3). Do not commit the real .env.
VITE_API_URL=https://your-api-id.execute-api.your-region.amazonaws.com
VITE_COGNITO_REGION=ap-south-1
VITE_COGNITO_POOL_ID=your-cognito-pool-id
VITE_COGNITO_CLIENT_ID=your-cognito-app-client-id
VITE_ORCHESTRATOR_ROLE_ARN=arn:aws:iam::YOUR_ACCOUNT_ID:role/InfraOrchestrator-GitHub-Role
